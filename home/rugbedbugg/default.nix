{
  pkgs,
  pkgs-unstable,
  vars,
  palette,
  ...
}:
{
  imports = [
    ./shell.nix
    ./hyprland.nix
    ./desktop-tools.nix
    ./keybinds.nix
    ./packages.nix
    ./media.nix
    ./files.nix
    ./wallpaper.nix
    ./git.nix
    ./gtk.nix
    ./qt.nix
    ./nvim.nix
  ];

  home = {
    username = vars.username;
    homeDirectory = "/home/${vars.username}";
    stateVersion = "26.05";
    # Classic X11 bitmap cursor: black outline, white fill, matching the
    # rice's old-school look. Paired with cursor.no_hardware_cursors in
    # hyprland.nix: this AMD iGPU's hardware cursor plane goes stale and
    # ignores theme changes entirely unless software cursor rendering is
    # forced.
    pointerCursor = {
      enable = true;
      package = pkgs.vanilla-dmz;
      name = "Vanilla-DMZ";
      size = 24;
      x11.enable = true;
      gtk.enable = true;
      hyprcursor.enable = true;
    };
  };
  xdg.enable = true;
  xdg.userDirs = {
    enable = true;
    createDirectories = true;
  };
  # Edge handles links, mail and the SUPER + B keybind. The CLI and Discord
  # schemes are declared too, so the whole file is reproducible instead of
  # half-generated by whichever app wrote it first.
  xdg.mimeApps = {
    enable = true;
    defaultApplications = {
      "x-scheme-handler/claude-cli" = "claude-code-url-handler.desktop";
      "x-scheme-handler/discord" = "vesktop.desktop";
      "text/html" = "microsoft-edge.desktop";
      "x-scheme-handler/http" = "microsoft-edge.desktop";
      "x-scheme-handler/https" = "microsoft-edge.desktop";
      "x-scheme-handler/about" = "microsoft-edge.desktop";
      "x-scheme-handler/unknown" = "microsoft-edge.desktop";
      "x-scheme-handler/mailto" = "microsoft-edge.desktop";
    };
  };
  fonts.fontconfig.enable = true;
  programs = {
    home-manager.enable = true;
    vim = {
      enable = true;
      # Sourced from nixpkgs-unstable — vim is in the daily-driver,
      # frequently-updated category alongside the unstable list in
      # packages.nix.
      packageConfigurable = pkgs-unstable.vim-full;
      # vim/0xNix.vim is the rice's colour scheme. It leaves the background
      # transparent, so the terminal's shows through, and its colours are
      # 24-bit: foot supports that, and the t_8f/t_8b sequences make vim
      # emit it whatever $TERM's terminfo says.
      extraConfig = ''
        let &t_8f = "\<Esc>[38;2;%lu;%lu;%lum"
        let &t_8b = "\<Esc>[48;2;%lu;%lu;%lum"
        set termguicolors
        syntax on
        colorscheme 0xNix

        "Kernel style C"
        filetype plugin indent on
        augroup c_kernel_style
          autocmd!
          autocmd FileType c,cpp setlocal noexpandtab tabstop=8 shiftwidth=8 softtabstop=8
          autocmd FileType c,cpp setlocal cindent cinoptions=:0,l1,t0g0,(0 
          autocmd FileType c,cpp setlocal textwidth=80 colorcolumn=81
        augroup END

        "Show tabs and trailing spaces so style errors are visible"
        set list
        set listchars=tab:>>\ ,trail:.
      '';
    };
  };
  home.file.".vim/colors/0xNix.vim".text =
    let
      colours = removeAttrs palette [
        "bare"
        "rgb"
        "ansi"
      ];
    in
    builtins.replaceStrings (map (name: "@${name}@") (
      builtins.attrNames colours
    )) (builtins.attrValues colours) (builtins.readFile ./vim/0xNix.vim);
}
