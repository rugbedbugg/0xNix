+        private void clip_partial_rows () {
+            float view_height = scrolled_window.get_height ();
+            for (unowned Gtk.Widget ?row = list_box.get_first_child ();
+                 row != null;
+                 row = row.get_next_sibling ()) {
+                Graphene.Rect bounds;
+                if (!row.compute_bounds (scrolled_window, out bounds)) {
+                    continue;
+                }
+                float top = bounds.origin.y;
+                float bottom = top + bounds.size.height;
+                bool fits = (top > -0.5f && bottom < view_height + 0.5f)
+                    || bounds.size.height > view_height;
+                row.set_opacity (fits ? 1.0 : 0.0);
+                if (row is NotificationGroup && !((NotificationGroup) row).dismissed) {
+                    row.set_can_target (fits);
+                }
+            }
+        }
