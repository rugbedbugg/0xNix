+        // Bitmap fonts can place the underline a row too low, onto the next
+        // line. Links and other underlined text take a colour instead.
+        private static Pango.AttrList recolour_underlines (Pango.AttrList attrs) {
+            Pango.Color colour = {};
+            if (!colour.parse ("@underlineColour@")) {
+                return attrs;
+            }
+            var result = new Pango.AttrList ();
+            foreach (unowned Pango.Attribute attr in attrs.get_attributes ()) {
+                if (attr.klass.type != Pango.AttrType.UNDERLINE) {
+                    result.insert (attr.copy ());
+                    continue;
+                }
+                Pango.Attribute fg = Pango.attr_foreground_new (
+                    colour.red, colour.green, colour.blue);
+                fg.start_index = attr.start_index;
+                fg.end_index = attr.end_index;
+                result.insert ((owned) fg);
+            }
+            return result;
+        }
+
+        private static string rich_text_to_markup (string text) {
+            string result = text;
+            for (int i = 0; i + 1 < RICH_TEXT_RULES.length; i += 2) {
+                try {
+                    var regex = new Regex (RICH_TEXT_RULES[i],
+                                           RegexCompileFlags.CASELESS
+                                           | RegexCompileFlags.MULTILINE);
+                    result = regex.replace (result, result.length, 0,
+                                            RICH_TEXT_RULES[i + 1]);
+                } catch (RegexError e) {
+                    stderr.printf ("Invalid regex %s: %s\n",
+                                   RICH_TEXT_RULES[i], e.message);
+                }
+            }
+            return result;
+        }
